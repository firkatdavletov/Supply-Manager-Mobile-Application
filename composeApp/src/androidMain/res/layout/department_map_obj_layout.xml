<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingBottom="50dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <FrameLayout
        android:id="@+id/card"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        app:layout_constraintBottom_toTopOf="@id/point"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="4dp"
        android:visibility="invisible"
        android:background="@drawable/background_tooltip_green800">

        <TextView
            android:id="@+id/label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:padding="4dp"
            android:textColor="#773310"
            android:textSize="12sp"
            android:layout_gravity="center"
            android:includeFontPadding="false"
            tools:ignore="MissingPrefix"
            tools:visibility="visible"
            tools:text="Круглосуточно" />
    </FrameLayout>

    <ImageView
        android:id="@+id/point"
        android:layout_width="27dp"
        android:layout_height="36dp"
        app:layout_constraintBottom_toTopOf="@id/marker_point"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="2dp"
        android:scaleType="fitXY"
        android:src="@drawable/ic_marker_point"
        android:contentDescription=""/>

    <ImageView
        android:id="@+id/marker_point"
        android:layout_width="27dp"
        android:layout_height="12dp"
        android:contentDescription=""
        app:srcCompat="@drawable/ic_marker_ellipse"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>